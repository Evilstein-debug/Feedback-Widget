{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "outDir": "./dist",
        "strict": false,
        "skipLibCheck": true,
        "esModuleInterop": true
    },
    "include": [
        "src/**/*",
        "generated/**/*"
    ],
    "exclude": [
        "node_modules"
    ]
}